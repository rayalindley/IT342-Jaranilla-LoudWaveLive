<resources>
    <style name="Base.Theme.Loudwavelivemobile" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#FF8FCF</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorSurface">#111111</item>
        <item name="colorOnSurface">#FFFFFF</item>
    </style>

    <style name="SuccessBottomSheetTheme" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/SuccessBottomSheet</item>
    </style>

    <style name="SuccessBottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">#1A1A1A</item>
        <item name="shapeAppearance">@style/SuccessBottomSheetShape</item>
    </style>

    <style name="SuccessBottomSheetShape" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <style name="Theme.Loudwavelivemobile" parent="Base.Theme.Loudwavelivemobile"/>
</resources>